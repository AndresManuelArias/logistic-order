# URL del backend Go (sin sufijo /api/v1). Expo sólo expone variables con el
# prefijo EXPO_PUBLIC_ al bundle: no pongas secretos aquí.
#
# Emulador Android -> http://10.0.2.2:8080
# Dispositivo físico -> http://<IP-LAN-de-tu-máquina>:8080
# iOS simulator     -> http://localhost:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Opcional: etiqueta del dispositivo que se envía en Bulk Sync (máx. 64).
EXPO_PUBLIC_DEVICE_NAME=driver-app

# Opcional: nivel de detalle en consola (debug | info | warn | error).
EXPO_PUBLIC_LOG_LEVEL=info

{
  "name": "tiendas-track-driver",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil offline-first del conductor de Tiendas-Track (F4)",
  "engines": {
    "node": "^20.19.4 || ^22.0.0 || >=24.0.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../backend/api/openapi.yaml -o src/contracts/generated/openapi.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/contracts/generated/openapi.ts"
  },
  "dependencies": {
    "@nozbe/watermelondb": "0.28.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~54.0.38",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}

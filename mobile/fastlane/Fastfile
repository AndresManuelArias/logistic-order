default_platform(:android)

# fastlane ejecuta las lanes desde mobile/fastlane/. Los comandos de Node
# (npm, npx) deben correr desde mobile/, donde está package.json. `npm` sube
# por los directorios hasta encontrarlo, pero `expo` no: buscaba
# fastlane/package.json y fallaba con ConfigError.
APP_ROOT = File.expand_path("..", __dir__)

def sh_in_app(*args)
  Dir.chdir(APP_ROOT) { sh(*args) }
end

platform :android do
  desc "Typecheck y pruebas unitarias de la app móvil"
  lane :test do
    sh_in_app("npm", "run", "typecheck")
    sh_in_app("npm", "run", "test")
  end

  desc "Bundle JS de producción con Expo (no requiere Android SDK)"
  lane :build do
    test
    sh_in_app("npx", "expo", "export", "--platform", "android", "--output-dir", "dist")
  end

  desc "Lane de CI: validación + bundle JS"
  lane :ci do
    build
  end

  desc "Build nativo iOS (solo macOS con Xcode)"
  lane :ios do
    unless RUBY_PLATFORM.include?("darwin")
      UI.user_error!(
        "La lane iOS requiere macOS con Xcode y credenciales de firma. " \
        "En Linux solo está soportada la lane `ci` (bundle JS)."
      )
    end
    sh("npx", "expo", "prebuild", "--platform", "ios")
    build_app(
      workspace: "ios/TiendasTrack.xcworkspace",
      scheme: "TiendasTrack",
      export_method: "app-store"
    )
  end
end

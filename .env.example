# Tiendas-Track — variables de entorno de EJEMPLO.
# Copia este archivo a .env y ajusta valores. .env está en .gitignore.
# NUNCA subir credenciales reales al repositorio.

# --- Base de datos (solo desarrollo local) ---
POSTGRES_USER=tiendas
POSTGRES_PASSWORD=tiendas_dev
POSTGRES_DB=tiendas
DB_PORT=5432

# --- Backend ---
APP_ENV=development
BACKEND_PORT=8080
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=30s
MIGRATE_ON_STARTUP=true
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=10s

# --- Portal web (placeholder hasta F4) ---
WEB_PORT=3000

# --- F5: Agente IA (no definidos aún; ver ADR-07) ---
# LLM_PROVIDER=
# LLM_API_KEY=

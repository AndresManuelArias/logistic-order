# Tiendas-Track — variables de entorno de EJEMPLO.
# Copia este archivo a .env y ajusta valores. .env está en .gitignore.
# NUNCA subir credenciales reales al repositorio.

# --- Base de datos (solo desarrollo local) ---
POSTGRES_USER=tiendas
POSTGRES_PASSWORD=tiendas_dev
POSTGRES_DB=tiendas
DB_PORT=5432

# --- Backend ---
APP_ENV=development
BACKEND_PORT=8080
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=30s
MIGRATE_ON_STARTUP=true
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=10s

# --- F2: autenticación JWT (RF-01, ADR-04) ---
# MÍNIMO 32 caracteres. En producción: generar con
#   openssl rand -hex 32
# y entregarlo por el gestor de secretos, nunca por git.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
GUEST_TOKEN_TTL=48h
BCRYPT_COST=10

# --- F3: tiempo real y resiliencia (RF-04, RNF-04, RNF-05) ---
# Orígenes permitidos en el handshake WS (separados por coma). Vacío = solo
# clientes sin Origin (apps nativas) y mismo host.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Validez de una suscripción WS antes de revalidarla contra el scope del token.
WS_GRANT_TTL=60s
# Circuit breaker de las lecturas de telemetría (RNF-05).
CB_FAILURE_THRESHOLD=5
CB_TIMEOUT=10s

# --- Portal web (F4) ---
WEB_PORT=3000
# URL del WebSocket que usa el NAVEGADOR (se incrusta al construir la imagen).
# En Docker local el backend se publica en localhost:8080.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- F5: Agente IA (RF-10, RNF-05) ---
# Sin AI_API_KEY (o GEMINI_API_KEY según el proveedor) el agente responde
# 503 AI_NOT_CONFIGURED y el resto del sistema sigue operativo.
#
# AI_PROVIDER selecciona la estrategia (patrón Strategy):
#   openai  → API compatible con OpenAI (OpenAI, Groq, Ollama, vLLM)
#   gemini  → API REST nativa de Google Gemini (generateContent)
#
# Configuración para OpenAI (por defecto):
AI_ENABLED=true
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20s
AI_MAX_STEPS=4

# Configuración alternativa para Gemini:
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_API_KEY=AIza...          <- tu Gemini API key
# AI_MODEL=gemini-1.5-flash

# --- F6: rate limiting (checklist §9.4) ---
# Login se limita por IP; telemetría e IA por usuario autenticado (fallback IP).
# Un valor 0 desactiva esa superficie. RATE_LIMIT_TRUST_PROXY=true solo detrás
# de un proxy de confianza (ALB/ingress), para usar X-Forwarded-For.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_TELEMETRY_PER_MIN=120
RATE_LIMIT_AI_PER_MIN=10
RATE_LIMIT_TRUST_PROXY=false
